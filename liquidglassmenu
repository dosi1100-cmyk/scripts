local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

pcall(function()
	local menuGui = localPlayer:WaitForChild("PlayerGui"):WaitForChild("MenuGui")
	local menu = menuGui:WaitForChild("Menu")

	local cfg = {
		GlassTransparency = 0.76,
		HoverGlowAlpha = 0.85,
		MaxBlurSize = 25,
		BorderTransparency = 0.35,
		CornerRadius = UDim.new(0, 32),
		MeltDuration = 1.4,
		GhostVFXAlpha = 0.95,
		GlassColor = Color3.fromRGB(255, 255, 255),
		TargetSize = UDim2.fromScale(0.85, 0.75),
		LoadTime = 1,
		Keywords = {
			"color", "picker", "palette", "slider", "hue", "hex", "rainbow", "rgb",
			"darkness", "lightness", "hsv", "gradient", "rejoin", "rj", "black",
			"dark", "logo", "close", "exit",
		},
	}

	local styled = {}
	local blurTween = nil

	local function matchKeyword(text)
		local lowered = string.lower(text)
		for _, keyword in ipairs(cfg.Keywords) do
			if string.find(lowered, keyword) then
				return true
			end
		end
		return false
	end

	local function isProtected(obj)
		if matchKeyword(obj.Name) then
			return true
		end
		local parent = obj.Parent
		local depth = 0
		while parent and depth < 4 do
			if parent:IsA("GuiObject") or parent:IsA("Folder") then
				if matchKeyword(parent.Name) then
					return true
				end
			end
			parent = parent.Parent
			depth += 1
		end
		return obj:IsA("TextBox")
	end

	local function lockTransparent(obj)
		if not obj:IsA("GuiObject") then
			return
		end
		local function enforce()
			if obj:GetAttribute("FTAP_Hovering") then
				return
			end
			if obj.BackgroundTransparency ~= 1 then
				obj.BackgroundTransparency = 1
			end
			if obj.BackgroundColor3 ~= Color3.new(1, 1, 1) then
				obj.BackgroundColor3 = Color3.new(1, 1, 1)
			end
		end
		enforce()
		obj:GetPropertyChangedSignal("BackgroundTransparency"):Connect(enforce)
		obj:GetPropertyChangedSignal("BackgroundColor3"):Connect(enforce)
	end

	local function melt(parent, mousePos)
		local ghost = Instance.new("Frame")
		ghost.BackgroundColor3 = Color3.new(1, 1, 1)
		ghost.BackgroundTransparency = cfg.GhostVFXAlpha
		ghost.AnchorPoint = Vector2.new(0.5, 0.5)
		local absPos = parent.AbsolutePosition
		ghost.Position = UDim2.fromOffset(mousePos.X - absPos.X, mousePos.Y - GuiService:GetGuiInset().Y - absPos.Y)
		ghost.Size = UDim2.fromOffset(0, 0)
		ghost.ZIndex = 5000
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = ghost
		ghost.Parent = parent
		TweenService:Create(ghost, TweenInfo.new(cfg.MeltDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(800, 800),
			BackgroundTransparency = 1,
		}):Play()
		Debris:AddItem(ghost, cfg.MeltDuration)
	end

	local function styleObject(obj)
		if not obj:IsA("GuiObject") then
			return
		end
		local lowered = string.lower(obj.Name)

		if lowered == "close" or lowered == "closebutton" or lowered == "exit" or lowered == "x" then
			obj.AnchorPoint = Vector2.new(1, 0)
			obj.Position = UDim2.new(1, 0, 0, 0)
		end

		if string.find(lowered, "star") or string.find(lowered, "favorite") or string.find(lowered, "fav") then
			if styled[obj] then
				return
			end
			styled[obj] = true

			local function clear()
				if obj.BackgroundTransparency ~= 1 then
					obj.BackgroundTransparency = 1
				end
				if obj.BorderSizePixel ~= 0 then
					obj.BorderSizePixel = 0
				end
			end
			clear()
			obj:GetPropertyChangedSignal("BackgroundTransparency"):Connect(clear)
			obj:GetPropertyChangedSignal("BorderSizePixel"):Connect(clear)

			local backInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			local sineInfo = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

			obj.MouseEnter:Connect(function()
				TweenService:Create(obj, backInfo, { Rotation = 15 }):Play()
			end)
			obj.MouseLeave:Connect(function()
				TweenService:Create(obj, backInfo, { Rotation = 0 }):Play()
			end)

			if obj:IsA("GuiButton") then
				local scale = obj:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", obj)
				obj.MouseButton1Down:Connect(function()
					TweenService:Create(scale, sineInfo, { Scale = 0.8 }):Play()
				end)
				obj.MouseButton1Up:Connect(function()
					TweenService:Create(scale, backInfo, { Scale = 1.2 }):Play()
					task.wait(0.15)
					TweenService:Create(scale, backInfo, { Scale = 1 }):Play()
				end)
			end
			return
		end

		if styled[obj] or isProtected(obj) then
			return
		end
		styled[obj] = true

		if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
			obj.BackgroundTransparency = 1
			obj.BorderSizePixel = 0
		elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
			obj.BackgroundTransparency = 1
		end

		lockTransparent(obj)

		if not obj:FindFirstChildOfClass("UICorner") then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 16)
			corner.Parent = obj
		end

		if obj:IsA("TextButton") or obj:IsA("ImageButton") then
			local glow = obj:FindFirstChild("LiquidGlow") or Instance.new("UIStroke")
			glow.Name = "LiquidGlow"
			glow.Thickness = 0
			glow.Color = Color3.new(1, 1, 1)
			glow.Transparency = 0.5
			glow.Parent = obj

			local scale = obj:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", obj)
			local isText = obj:IsA("TextButton")
			local baseSize = isText and obj.TextSize or 14
			local baseColor = isText and obj.TextColor3 or Color3.new(1, 1, 1)

			obj.MouseEnter:Connect(function()
				obj:SetAttribute("FTAP_Hovering", true)
				TweenService:Create(obj, TweenInfo.new(0.35), {
					BackgroundTransparency = cfg.HoverGlowAlpha,
					BackgroundColor3 = Color3.fromRGB(230, 240, 255),
				}):Play()
				TweenService:Create(glow, TweenInfo.new(0.35), { Thickness = 2.4 }):Play()
				TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.05 }):Play()
				if isText then
					TweenService:Create(obj, TweenInfo.new(0.3), {
						TextSize = baseSize + 2,
						TextColor3 = Color3.fromRGB(150, 200, 255),
					}):Play()
				end
			end)

			obj.MouseLeave:Connect(function()
				local tween = TweenService:Create(obj, TweenInfo.new(0.35), {
					BackgroundTransparency = 1,
					BackgroundColor3 = cfg.GlassColor,
				})
				tween:Play()
				TweenService:Create(glow, TweenInfo.new(0.35), { Thickness = 0 }):Play()
				TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				if isText then
					TweenService:Create(obj, TweenInfo.new(0.3), {
						TextSize = baseSize,
						TextColor3 = baseColor,
					}):Play()
				end
				tween.Completed:Connect(function()
					obj:SetAttribute("FTAP_Hovering", false)
				end)
			end)

			obj.MouseButton1Down:Connect(function()
				if obj.Name ~= "RejoinButton" then
					TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Sine), { Scale = 0.93 }):Play()
				end
				melt(obj, UserInputService:GetMouseLocation())
			end)

			obj.MouseButton1Up:Connect(function()
				if obj.Name ~= "RejoinButton" then
					TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.05 }):Play()
				end
			end)
		end
	end

	local function buildRejoin()
		local old = menu:FindFirstChild("RejoinContainer")
		if old then
			old:Destroy()
		end

		local container = Instance.new("Frame")
		container.Name = "RejoinContainer"
		container.Size = UDim2.fromOffset(120, 40)
		container.Position = UDim2.new(0, 20, 0, 20)
		container.BackgroundTransparency = 1
		container.ZIndex = 10000
		container.Parent = menu

		local button = Instance.new("TextButton")
		button.Name = "RejoinButton"
		button.Size = UDim2.fromScale(1, 1)
		button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		button.BackgroundTransparency = 1
		button.Text = "REJOIN"
		button.TextColor3 = Color3.new(1, 1, 1)
		button.TextSize = 14
		button.Font = Enum.Font.GothamBold
		button.Parent = container

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = button

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Transparency = 0.4
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button

		local armed = false
		local scale = Instance.new("UIScale", button)

		button.MouseButton1Click:Connect(function()
			if not armed then
				armed = true
				button.Text = "REJOIN?"
				TweenService:Create(button, TweenInfo.new(0.3), {
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BackgroundTransparency = 0.5,
				}):Play()
				TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.15 }):Play()
				task.wait(0.15)
				TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

				task.delay(2.5, function()
					if armed then
						armed = false
						button.Text = "REJOIN"
						TweenService:Create(button, TweenInfo.new(0.3), {
							BackgroundColor3 = Color3.fromRGB(255, 255, 255),
							BackgroundTransparency = 1,
						}):Play()
					end
				end)
			else
				button.Text = "WAIT..."
				TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Sine), { Scale = 1.1 }):Play()

				pcall(function()
					if #Players:GetPlayers() <= 1 then
						localPlayer:Kick("\nRejoining...")
						task.wait(0.1)
						TeleportService:Teleport(game.PlaceId, localPlayer)
					else
						TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
					end
				end)
			end
		end)

		styleObject(button)
	end

	local function setBlur(enabled)
		local blur = Lighting:FindFirstChild("Nucleus_World_Blur") or Instance.new("BlurEffect", Lighting)
		blur.Name = "Nucleus_World_Blur"
		if enabled then
			TweenService:Create(blur, TweenInfo.new(0.3, Enum.EasingStyle.Sine), { Size = cfg.MaxBlurSize }):Play()
		else
			TweenService:Create(blur, TweenInfo.new(0.3), { Size = 0 }):Play()
		end
	end

	local function setMenuState(enabled)
		setBlur(enabled)

		if blurTween then
			blurTween:Cancel()
			blurTween = nil
		end

		if enabled then
			menu.Size = cfg.TargetSize
			menu.AnchorPoint = Vector2.new(0.5, 0.5)
			menu.Position = UDim2.fromScale(0.5, 0.5)
			menuGui.DisplayOrder = 10000
			menu.Visible = true
		else
			menu.Visible = false
		end
	end

	local wasVisible = menu.Visible
	if wasVisible then
		menu.Visible = false
	end

	local proxy = menu:FindFirstChild("_Nucleus_Proxy") or Instance.new("Frame", menu)
	proxy.Name = "_Nucleus_Proxy"
	proxy.Size = UDim2.fromScale(1, 1)
	proxy.Position = UDim2.fromScale(0.5, 0.5)
	proxy.AnchorPoint = Vector2.new(0.5, 0.5)
	proxy.BackgroundColor3 = cfg.GlassColor
	proxy.BackgroundTransparency = cfg.GlassTransparency
	proxy.ZIndex = -2
	Instance.new("UICorner", proxy).CornerRadius = cfg.CornerRadius

	local proxyStroke = Instance.new("UIStroke", proxy)
	proxyStroke.Thickness = 3
	proxyStroke.Color = Color3.new(1, 1, 1)
	proxyStroke.Transparency = cfg.BorderTransparency
	proxyStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	buildRejoin()
	lockTransparent(menu)

	menu.DescendantAdded:Connect(function(descendant)
		styleObject(descendant)
	end)

	local function finish()
		menu:GetPropertyChangedSignal("Visible"):Connect(function()
			setMenuState(menu.Visible)
		end)

		if wasVisible or menu.Visible then
			setMenuState(true)
		end
	end

	local descendants = menu:GetDescendants()
	local total = #descendants
	local index = 0
	local startTime = os.clock()
	local connection = nil

	connection = RunService.Heartbeat:Connect(function()
		local ratio = math.min((os.clock() - startTime) / cfg.LoadTime, 1)
		local goal = math.ceil(total * ratio)

		while index < goal do
			index += 1
			local obj = descendants[index]
			if obj and obj.Parent then
				pcall(styleObject, obj)
			end
		end

		if index >= total then
			connection:Disconnect()
			finish()
		end
	end)
end)
