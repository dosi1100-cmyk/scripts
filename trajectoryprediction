local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local linePool = {}
local activeLines = 0
local markerPool = {}
local activeMarkers = 0

local visualFolder = Workspace.Terrain:FindFirstChild("TrajectoryVisuals")
if not visualFolder then
    visualFolder = Instance.new("Folder")
    visualFolder.Name = "TrajectoryVisuals"
    visualFolder.Parent = Workspace.Terrain
end

local function resetVisuals()
    activeLines = 0
    activeMarkers = 0
end

local function hideUnusedVisuals()
    local farAway = CFrame.new(0, 99999, 0)
    
    for i = activeLines + 1, #linePool do
        if linePool[i].Visible then
            linePool[i].Visible = false
            linePool[i].CFrame = farAway
        end
    end
    for i = activeMarkers + 1, #markerPool do
        markerPool[i].CFrame = farAway
    end
end

local function create3DLine(p1, p2, ratio)
    activeLines = activeLines + 1
    local cyl = linePool[activeLines]
    
    if not cyl then
        cyl = Instance.new("CylinderHandleAdornment")
        cyl.Adornee = Workspace.Terrain
        cyl.AlwaysOnTop = false
        cyl.Radius = 0.04
        cyl.ZIndex = 1
        cyl.Parent = visualFolder
        table.insert(linePool, cyl)
    end
    
    local startColor = Color3.fromRGB(0, 255, 255)
    local endColor = Color3.fromRGB(170, 0, 255)
    cyl.Color3 = startColor:Lerp(endColor, ratio)
    cyl.Transparency = 0.8 * ratio
    
    cyl.Height = (p2 - p1).Magnitude
    cyl.CFrame = CFrame.lookAt((p1 + p2) / 2, p2)
    cyl.Visible = true
end

local function create3DImpactMarker(pos)
    activeMarkers = activeMarkers + 1
    local marker = markerPool[activeMarkers]
    
    if not marker then
        marker = Instance.new("Part")
        marker.Shape = Enum.PartType.Ball
        marker.Material = Enum.Material.Neon
        marker.Size = Vector3.new(2, 2, 2)
        marker.Color = Color3.fromRGB(255, 80, 120)
        marker.CanCollide = false
        marker.CanQuery = false
        marker.CanTouch = false
        marker.Anchored = true
        marker.Parent = visualFolder
        table.insert(markerPool, marker)
    end
    
    marker.CFrame = CFrame.new(pos)
end

local function predictTrajectory(mainPart, v0, ignoreObj)
    local p0 = mainPart.Position
    local g = Vector3.new(0, -Workspace.Gravity, 0) 
    
    local timeStep = 0.03 
    local maxDuration = 2.5 
    local currentPos = p0
    
    for t = 0, maxDuration, timeStep do
        local nextPos = p0 + (v0 * t) + (0.5 * g * (t * t))
        local ratio = t / maxDuration 
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {ignoreObj, Players.LocalPlayer.Character}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local direction = nextPos - currentPos
        local raycastResult = Workspace:Raycast(currentPos, direction, raycastParams)
        
        if raycastResult then
            local hitPos = raycastResult.Position
            create3DLine(currentPos, hitPos, ratio)
            create3DImpactMarker(hitPos) 
            break
        end
        
        create3DLine(currentPos, nextPos, ratio)
        currentPos = nextPos
    end
end

local function calculateExactThrowVelocity(camera, obj)
    local totalMass = 0
    local isModel = obj:IsA("Model")
    
    if isModel then
        for _, part in pairs(obj:GetChildren()) do
            if part:IsA("BasePart") then
                totalMass = totalMass + part.Mass
            end
        end
    elseif obj:IsA("BasePart") then
        totalMass = obj.Mass
    end
    
    if totalMass <= 0 then totalMass = 1 end 
    
    local calcVelocity = (camera.CFrame.LookVector * 750 / totalMass) + (camera.CFrame.LookVector * 15)
    
    if isModel then
        if calcVelocity.Magnitude > 100 then
            calcVelocity = camera.CFrame.LookVector * 100
        elseif calcVelocity.Magnitude < 50 then
            calcVelocity = camera.CFrame.LookVector * 50
        end
    else
        if calcVelocity.Magnitude > 100 then
            calcVelocity = camera.CFrame.LookVector * 100
        end
    end
    
    return calcVelocity
end

local function isObjectAnchored(obj)
    if obj:IsA("Model") then
        for _, part in pairs(obj:GetDescendants()) do
            if part:IsA("BasePart") and part.Anchored then
                return true
            end
        end
    elseif obj:IsA("BasePart") then
        return obj.Anchored
    end
    return false
end

local trackedObjects = {}

RunService.RenderStepped:Connect(function()
    resetVisuals()
    
    local camera = Workspace.CurrentCamera
    if not camera then 
        hideUnusedVisuals()
        return 
    end

    local currentGrabbedObj = nil
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name == "GrabParts" and obj:FindFirstChild("GrabPart") then
            local weld = obj.GrabPart:FindFirstChildWhichIsA("WeldConstraint")
            if weld and weld.Part1 then
                currentGrabbedObj = weld.Part1
                if currentGrabbedObj.Parent and currentGrabbedObj.Parent:IsA("Model") and currentGrabbedObj.Parent ~= Workspace then
                    currentGrabbedObj = currentGrabbedObj.Parent
                end
                break
            end
        end
    end

    if currentGrabbedObj then
        trackedObjects[currentGrabbedObj] = true
    end
    
    for obj, _ in pairs(trackedObjects) do
        if obj and obj:IsDescendantOf(Workspace) then
            if isObjectAnchored(obj) then
                if obj == currentGrabbedObj then
                    continue
                end
            end

            local mainPart = nil
            if obj:IsA("Model") then
                mainPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            elseif obj:IsA("BasePart") then
                mainPart = obj
            end
            
            if mainPart then
                local v0 = mainPart.AssemblyLinearVelocity
                local isCurrentlyGrabbed = (obj == currentGrabbedObj)
                
                if isCurrentlyGrabbed then
                    v0 = calculateExactThrowVelocity(camera, obj)
                else
                    if v0.Magnitude < 1 or isObjectAnchored(obj) then
                        trackedObjects[obj] = nil
                        continue
                    end
                end
                
                predictTrajectory(mainPart, v0, obj)
            else
                trackedObjects[obj] = nil
            end
        else
            trackedObjects[obj] = nil
        end
    end
    
    hideUnusedVisuals()
end)
