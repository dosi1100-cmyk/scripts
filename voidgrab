end

getgenv().LoopGrabActive = true
game.StarterGui:SetCore("SendNotification", {
    Title = "Void Grab",
    Text = "bozi Grab이 켜졌습니다.",
    Duration = 3
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local plr = Players.LocalPlayer

local destroyThread = nil

local function startDestroy(part)
    local original = workspace.FallenPartsDestroyHeight

    if destroyThread then
        task.cancel(destroyThread)
    end

    destroyThread = task.delay(math.clamp(plr:GetNetworkPing() + 0.05, 0.08, 0.25), function()
        workspace.FallenPartsDestroyHeight = -10000
        task.wait()
        workspace.FallenPartsDestroyHeight = original
        destroyThread = nil
    end)

    task.delay(0.5, function()
        local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
        local remote = grabEvents and grabEvents:FindFirstChild("DestroyGrabLine")
        if remote then
            remote:FireServer(part)
        end
    end)
end

local function sendVoid(part, ownerPlayer)
    if not part.Parent then
        return
    end

    local model = ownerPlayer and ownerPlayer.Character or part:FindFirstAncestorOfClass("Model")

    pcall(function()
        if model then
            model:PivotTo(CFrame.new(0, -11111, 0))
        else
            part.CFrame = CFrame.new(0, -11111, 0)
        end
    end)
end

task.spawn(function()
    while getgenv().LoopGrabActive do
        local grabParts = workspace:FindFirstChild("GrabParts")
        if not grabParts then
            task.wait()
            continue
        end

        local gp = grabParts:FindFirstChild("GrabPart")
        local weld = gp and gp:FindFirstChildOfClass("WeldConstraint")
        local part1 = weld and weld.Part1

        if part1 then
            local ownerPlayer = nil
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl.Character and part1:IsDescendantOf(pl.Character) then
                    ownerPlayer = pl
                    break
                end
            end

            local started = false

            while getgenv().LoopGrabActive and workspace:FindFirstChild("GrabParts") do
                if not part1.Anchored then
                    if not started then
                        started = true
                        startDestroy(part1)
                    end
                    sendVoid(part1, ownerPlayer)
                end
                task.wait()
            end
        end
        task.wait()
    end
end)

